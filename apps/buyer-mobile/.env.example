EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
# iOS-restricted Google Maps key (Google Cloud Console > Credentials) for the
# native map picker's PROVIDER_GOOGLE. Wired into app.config.js's
# ios.config.googleMapsApiKey. Android has no equivalent key configured yet —
# see the comment in app.config.js.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
